# Copy to .env (git-ignored) or set these as secrets in your environment.
# Never commit real values. Keep comments on their own lines.

# --- Mail (required for `run --send` and `scheduled`; without them, dry runs still work) ---
# SMTP server host
NEWSTRIAGE_SMTP_HOST=
# 587 = STARTTLS, 465 = SSL
NEWSTRIAGE_SMTP_PORT=587
NEWSTRIAGE_SMTP_USER=
NEWSTRIAGE_SMTP_PASSWORD=
NEWSTRIAGE_MAIL_FROM=
# comma-separated recipients
NEWSTRIAGE_MAIL_TO=

# --- Optional: Claude enrichment. Without a key the pipeline runs on rules alone ---
ANTHROPIC_API_KEY=
# NEWSTRIAGE_MODEL=claude-sonnet-5-5

# --- Optional: contact shown in the HTTP User-Agent ---
NEWSTRIAGE_CONTACT_EMAIL=

# --- Optional paths (defaults: ./config, ./data, ./out) ---
# NEWSTRIAGE_CONFIG_DIR=
# NEWSTRIAGE_DATA_DIR=
# NEWSTRIAGE_OUT_DIR=
